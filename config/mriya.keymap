#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB  &kp ESCAPE  &kp Q  &kp W     &kp E      &kp R            &kp T          &kp Y         &kp U           &kp I         &kp O     &kp P     &kp BACKSPACE  &kp ENTER
         &kp LCTRL   &kp A  &kp S     &kp D      &kp F            &kp G          &kp H         &kp J           &kp K         &kp L     &kp SEMI  &mt RCTRL SQT
         &kp LALT    &kp Z  &kp X     &kp C      &kp V            &kp B          &kp N         &kp M           &kp COMMA     &kp DOT   &kp FSLH  &kp RALT
                            &kp LGUI  &lt 2 TAB  &mt LSHFT SPACE  &lt 1 ENTER    &lt 1 ESCAPE  &mt RSHFT BSPC  &lt 2 DELETE  &kp RGUI
            >;
        };

        lower_layer {
            bindings = <
&trans  &kp UNDER       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp LEFT_BRACKET         &kp RIGHT_BRACKET
        &mt LCTRL PLUS  &kp EXCL      &kp AT        &kp HASH      &kp DLLR      &kp PRCNT       &kp CARET     &kp AMPS      &kp STAR      &kp LPAR      &kp RPAR      &mt RCTRL MINUS
        &mt LALT EQUAL  &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &mt RIGHT_ALT BACKSLASH
                                      &trans        &lt 3 TAB     &trans        &trans          &trans        &trans        &lt 3 DEL     &trans
            >;
        };

        raise_layer {
            bindings = <
&trans  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_PREV        &kp C_PLAY_PAUSE  &kp C_NEXT         &kp LC(LA(F))    &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp PG_UP  &kp PAGE_UP    &kp HOME       &trans
        &mt LCTRL LC(LA(A))   &kp LC(LA(LEFT))      &kp LA(LC(DOWN))  &kp LC(LA(UP))    &kp LC(LA(RIGHT))  &kp LC(LA(C))    &kp LEFT    &kp DOWN      &kp UP        &kp RIGHT  &kp PAGE_DOWN  &mt RCTRL END
        &kp F1                &kp F2                &kp F3            &kp F4            &kp F5             &kp F6           &kp F7      &kp F8        &kp F9        &kp F10    &kp F11        &kp F12
                                                    &trans            &trans            &trans             &lt 3 RET        &lt 3 ESC   &trans        &trans        &trans
            >;
        };

        adjust_layer {
            bindings = <
&none  &bootloader  &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &bootloader  &none
       &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
       &sys_reset   &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &sys_reset
                                  &none         &trans        &none         &trans          &trans        &none         &trans        &none
            >;
        };
    };
};
